---
import Container from './Container.astro';
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import { localeName, locales, localePath, type Locale } from '../i18n/config';
import { navigation, useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Path without a locale prefix, e.g. `/about`. */
  path: string;
  /** Paths per language when they differ from `path` (see BaseLayout). */
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, path, alternates } = Astro.props;
// Without a translation the switcher leads to the other language's blog index.
const switchPath = (candidate: Locale) => (alternates ? (alternates[candidate] ?? '/blog') : path);
const t = useTranslations(locale);

const isCurrent = (itemPath: string) => path === itemPath || path.startsWith(`${itemPath}/`);
---

<Container>
  <nav class="relative flex items-center justify-between py-5.5" aria-label={t('nav.label')}>
    <a
      class="flex items-center gap-2.5 font-mono text-base font-semibold"
      href={localePath(locale, '/')}
    >
      <Mark />
      max mayr
    </a>

    <div class="flex items-center gap-1 md:gap-5">
      <button
        type="button"
        class="navbar-burger order-last -mr-2 flex size-11 cursor-pointer items-center justify-center md:hidden"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="navbar-menu"
      >
        <Icon name="menu" size={24} />
      </button>

      <div
        id="navbar-menu"
        class="navbar-menu absolute top-full right-0 left-0 z-20 hidden border-y border-rule bg-paper py-2 md:static md:flex md:border-0 md:bg-transparent md:py-0"
      >
        <ul class="md:flex md:items-center md:gap-6.5">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={localePath(locale, item.path)}
                  aria-current={isCurrent(item.path) ? 'page' : undefined}
                  class="block py-2.5 decoration-2 underline-offset-[6px] hover:underline aria-[current=page]:underline md:py-0"
                >
                  {t(item.key)}
                </a>
              </li>
            ))
          }
          <li class="py-2.5 text-muted md:py-0" aria-label={t('nav.language')}>
            {
              locales.map((candidate, index) => (
                <Fragment>
                  {index > 0 && ' / '}
                  {candidate === locale ? (
                    <span class="text-ink" aria-current="true">
                      {localeName[candidate]}
                    </span>
                  ) : (
                    <a
                      class="hover:text-ink"
                      href={localePath(candidate, switchPath(candidate))}
                      hreflang={candidate}
                    >
                      {localeName[candidate]}
                    </a>
                  )}
                </Fragment>
              ))
            }
          </li>
        </ul>
      </div>

      <button
        type="button"
        class="theme-toggle flex size-11 cursor-pointer items-center justify-center text-muted hover:text-ink md:order-last md:-mr-3"
        aria-label={t('nav.theme')}
        aria-pressed="false"
      >
        <Icon name="moon" size={20} class="dark:hidden" />
        <Icon name="sun" size={20} class="hidden dark:block" />
      </button>
    </div>
  </nav>
</Container>
