---
import { localePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="bg-surface-footer px-6 pt-12 pb-24 text-center">
  <p>
    <strong>{t('footer.madeWith')}</strong>
    {t('footer.by')}
    <a class="link" href={localePath(locale, '/about')}>Max Mayr</a>. {t('footer.sourceLicense')}
    <a class="link" href="http://opensource.org/licenses/mit-license.php">MIT</a>. {
      t('footer.contentLicense')
    }
    <a class="link" href="http://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY NC SA 4.0</a>.
  </p>
  <p class="mt-4 flex justify-center gap-4">
    <a class="link" href={localePath(locale, '/impressum')}>{t('footer.impressum')}</a>
    <a class="link" href={localePath(locale, '/datenschutz')}>{t('footer.datenschutz')}</a>
  </p>
</footer>
