---
import Container from './Container.astro';
import { localePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="border-t border-rule text-[15px] text-muted">
  <Container class="flex flex-wrap justify-between gap-x-8 gap-y-3 pt-6.5 pb-12">
    <span class="flex flex-wrap gap-x-5 gap-y-1">
      <a
        class="underline-offset-4 hover:text-ink hover:underline"
        href={localePath(locale, '/impressum')}
      >
        {t('footer.impressum')}
      </a>
      <a
        class="underline-offset-4 hover:text-ink hover:underline"
        href={localePath(locale, '/datenschutz')}
      >
        {t('footer.datenschutz')}
      </a>
      <a
        class="underline-offset-4 hover:text-ink hover:underline"
        href={`${localePath(locale, '/datenschutz')}#8-zugriffsstatistik-mit-plausible`}
      >
        {t('footer.noTracking')}
      </a>
      <span>
        {t('footer.code')}
        <a
          class="underline underline-offset-4 hover:text-ink"
          href="https://opensource.org/licenses/MIT">MIT</a
        >,
        {t('footer.content')}
        <a
          class="underline underline-offset-4 hover:text-ink"
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a
        >
      </span>
    </span>
    <span class="font-mono">{t('footer.hosting')}</span>
  </Container>
</footer>
