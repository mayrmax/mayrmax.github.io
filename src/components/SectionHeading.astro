---
import Rule from './Rule.astro';

interface Props {
  title: string;
  /** Only the page's own main heading is an h1; every other section is an h2. */
  as?: 'h1' | 'h2';
}

const { title, as: Tag = 'h2' }: Props = Astro.props;
---

<div class="text-center">
  <Tag class="text-[2rem] leading-tight font-semibold">{title}</Tag>
  <Rule />
</div>
