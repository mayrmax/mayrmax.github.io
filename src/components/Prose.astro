---
/**
 * Rendered markdown. Its elements cannot carry classes, so they are styled from
 * the wrapper with arbitrary variants. Text size and width come from the caller.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    'leading-[1.6]',
    '[&_p+p]:mt-4 [&_p+ul]:mt-4 [&_ul+p]:mt-4',
    '[&_a]:underline [&_a]:decoration-1 [&_a]:underline-offset-4 [&_a:hover]:decoration-2',
    '[&_strong]:font-bold [&_em]:italic',
    "[&_ul]:list-['–_'] [&_ul]:pl-5 [&_li]:mt-1 [&_li]:marker:text-muted",
    '[&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2:first-child]:mt-0',
    className,
  ]}
>
  <slot />
</div>
