---
/**
 * The powerline prompt above the headline. Flags in the command are muted so
 * the line reads as the services list in miniature. Each flag stays on a line
 * with its value, so a narrow screen breaks the command between options, never
 * inside one, and a wrapped line starts flush left like a terminal's would.
 */
interface Props {
  command: string;
}

const { command } = Astro.props;

// Literal class strings, so Tailwind can see every colour it has to generate.
const segments = [
  { text: 'max', color: 'bg-pl-blue after:border-l-pl-blue' },
  { text: '~', color: 'bg-pl-red after:border-l-pl-red' },
  { text: '$', color: 'bg-pl-green after:border-l-pl-green' },
];

// "build --ai llm,rag" becomes [["build"], ["--ai", "llm,rag"]].
const groups: string[][] = [];
for (const token of command.split(' ')) {
  const last = groups.at(-1);
  if (last && last[0].startsWith('--') && last.length === 1 && !token.startsWith('--')) {
    last.push(token);
  } else {
    groups.push([token]);
  }
}
---

<p class="font-mono text-[clamp(15px,1.8vw,20px)] leading-[2.1]">
  <span class="mr-[1.4em] inline-flex align-middle font-semibold">
    {
      segments.map((segment, index) => (
        <span
          class:list={[
            "relative inline-flex h-[1.75em] items-center pr-[0.5em] text-black after:absolute after:top-0 after:-right-[0.875em] after:z-10 after:border-y-[0.875em] after:border-l-[0.875em] after:border-y-transparent after:content-['']",
            index === 0 ? 'pl-[0.6em]' : 'pl-[1.1em]',
            segment.color,
          ]}
        >
          {segment.text}
        </span>
      ))
    }
  </span>
  {
    groups.map((group, index) => (
      <Fragment>
        {index > 0 && ' '}
        <span class="whitespace-nowrap">
          {group.map((token, position) => (
            <Fragment>
              {position > 0 && ' '}
              <span class:list={[token.startsWith('--') && 'text-muted']}>{token}</span>
            </Fragment>
          ))}
          {index === groups.length - 1 && (
            <span
              class="ml-[0.2em] inline-block h-[1.15em] w-[0.6em] animate-blink bg-black align-[-0.2em] motion-reduce:animate-none"
              aria-hidden="true"
            />
          )}
        </span>
      </Fragment>
    ))
  }
</p>
