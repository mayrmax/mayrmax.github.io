---
import { Font } from 'astro:assets';

import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import StructuredData from '../components/StructuredData.astro';
import {
  defaultLocale,
  htmlLang,
  localePath,
  locales,
  ogLocale,
  type Locale,
} from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { ogImagePath } from '../og/paths';
import type { ComponentProps } from 'astro/types';

interface Props {
  locale: Locale;
  /** Path without a locale prefix, e.g. `/about`. Drives the nav highlight,
      the language switcher and the alternate-language links. */
  path: string;
  /** Page name; the site name is appended for the <title>. */
  title: string;
  description?: string;
  /** Keep the page out of search results and off the canonical trail. */
  noindex?: boolean;
  /** Extra schema.org node for this page. */
  schema?: ComponentProps<typeof StructuredData>['page'];
  article?: ComponentProps<typeof StructuredData>['article'];
  services?: ComponentProps<typeof StructuredData>['services'];
}

const {
  locale,
  path,
  title,
  description,
  noindex = false,
  schema,
  article,
  services,
} = Astro.props;
const t = useTranslations(locale);

const siteName = t('site.name');
// "About — Max Mayr": the page first, the brand after, so the useful half
// survives truncation in a result listing.
const documentTitle = title === siteName ? title : `${title} — ${siteName}`;

const metaDescription = description ?? t('meta.description');
const canonical = new URL(localePath(locale, path), Astro.site).href;
// Every page has its own preview (src/pages/og); the 404 borrows the home page's.
const socialImage = new URL(ogImagePath(locale, noindex ? '/' : path), Astro.site).href;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>

    <meta name="author" content="Max Mayr" />
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={t('meta.keywords')} />

    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <Fragment>
          <link rel="canonical" href={canonical} />
          {locales.map((alternate) => (
            <link
              rel="alternate"
              hreflang={htmlLang[alternate]}
              href={new URL(localePath(alternate, path), Astro.site).href}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(localePath(defaultLocale, path), Astro.site).href}
          />
          <meta property="og:url" content={canonical} />
        </Fragment>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={documentTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Max Mayr"
      href={localePath(locale, '/feed.xml')}
    />

    <script is:inline>
      // Resolve the theme before first paint, so a dark page never flashes
      // white. A choice made with the toggle wins over the system setting.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-jetbrains" preload />
  </head>
  <body class="bg-paper font-sans wrap-break-word text-lg leading-[1.55] text-ink antialiased">
    {
      !noindex && (
        <StructuredData locale={locale} page={schema} article={article} services={services} />
      )
    }
    <Navigation locale={locale} path={path} />
    <!-- Pages that end on the contact block run straight into the footer. -->
    <main class="pb-24 [&:has(>[data-contact]:last-child)]:pb-0">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
