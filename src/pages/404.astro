---
import Container from '../components/Container.astro';
import Prompt from '../components/Prompt.astro';
import Prose from '../components/Prose.astro';
import { getSection } from '../i18n/content';
import { defaultLocale, localeName, localePath, locales } from '../i18n/config';
import BaseLayout from '../layouts/BaseLayout.astro';

// GitHub Pages and nginx both serve this one file for every missing path, so
// it is English with a way across to the German home page.
const intros = await getSection('page-intros', defaultLocale);
---

<BaseLayout locale={defaultLocale} path="/404" title="404 — Page not found" noindex>
  <Container class="pt-14 pb-10 sm:pt-24">
    <Prompt command="cd this-page" />
    <p class="mt-6 font-mono text-muted">No such file or directory</p>
    <h1
      class="hyphens-auto mt-12 text-[clamp(40px,6vw,72px)] leading-[1.02] font-bold tracking-[-0.025em]"
    >
      {intros.notFoundSubtitle}
    </h1>
    <Prose class="mt-4 max-w-xl text-xl text-muted"><intros.Content /></Prose>
    <p class="mt-8 flex gap-6 font-mono">
      {
        locales.map((locale) => (
          <a
            class="underline underline-offset-4 hover:decoration-2"
            href={localePath(locale, '/')}
            hreflang={locale}
          >
            {localeName[locale]}
          </a>
        ))
      }
    </p>
  </Container>
</BaseLayout>
