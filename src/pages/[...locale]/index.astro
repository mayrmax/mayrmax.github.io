---
import type { GetStaticPaths } from 'astro';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSection } from '../../i18n/content';
import { localePath } from '../../i18n/config';
import { localeRoutes } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = await getSection('home', locale);
---

<BaseLayout
  locale={locale}
  path="/"
  title={home.seoTitle ?? t('title.home')}
  description={t('meta.home')}
>
  <section class="flex min-h-[calc(100vh-3.25rem)] flex-col justify-center px-6 py-12">
    <div>
      {/* A lead-in, not a heading — an h2 here sat above the page's only h1. */}
      <p class="mb-7 ml-1 font-body text-[26px] tracking-[-2px] text-ink-faint">
        {home.greeting}
      </p>
      <h1
        class="mt-1 mb-12 font-mono text-[64px] leading-none tracking-[-4px] sm:text-[100px] sm:tracking-[-7px]"
      >
        <a class="text-black" href={localePath(locale, '/about')}>{home.name}</a>
      </h1>
      <div
        class="prose-content max-w-4xl font-body text-2xl tracking-[2px] text-ink-faint sm:text-[34px]"
      >
        <home.Content />
      </div>
      {
        home.ctaLabel && (
          <a
            class="mt-12 inline-block border-2 border-black px-6 py-3 font-mono text-lg text-black transition-colors hover:bg-black hover:text-white"
            href={localePath(locale, '/services')}
          >
            {home.ctaLabel} →
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>
