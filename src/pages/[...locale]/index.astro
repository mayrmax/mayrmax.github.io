---
import type { GetStaticPaths } from 'astro';

import Contact from '../../components/Contact.astro';
import Container from '../../components/Container.astro';
import Prompt from '../../components/Prompt.astro';
import Prose from '../../components/Prose.astro';
import Row from '../../components/Row.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { localePath } from '../../i18n/config';
import { getLocalized, getLocalizedRendered, getSection } from '../../i18n/content';
import { localeRoutes } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);

const [home, intros, services, references] = await Promise.all([
  getSection('home', locale),
  getSection('page-intros', locale),
  getLocalizedRendered('services', locale),
  getLocalized('references', locale),
]);
const featured = references.filter((reference) => reference.data.featured);
---

<BaseLayout
  locale={locale}
  path="/"
  title={home.seoTitle ?? t('title.home')}
  description={t('meta.home')}
>
  <section class="border-b border-rule">
    <Container class="pt-14 pb-16 sm:pt-24 sm:pb-26">
      {home.command && <Prompt command={home.command} />}
      <h1
        class="hyphens-auto mt-10 max-w-[18ch] text-[clamp(40px,6vw,76px)] leading-[1.02] font-bold tracking-[-0.025em] sm:mt-12"
      >
        {home.headline}
      </h1>
      <Prose class="mt-5.5 max-w-xl text-xl text-muted"><home.Content /></Prose>
      <div class="mt-8.5 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a
          class="inline-block bg-ink px-5.5 py-3.5 font-bold text-paper hover:bg-ink/85 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-pl-blue"
          href={`#${t('contact.anchor')}`}
        >
          {home.contactLabel}
        </a>
        {
          home.ctaLabel && (
            <a
              class="font-bold underline decoration-1 underline-offset-4 hover:decoration-2"
              href={localePath(locale, '/services')}
            >
              {home.ctaLabel}
            </a>
          )
        }
      </div>
    </Container>
  </section>

  <section>
    <Container class="pt-22">
      <SectionTitle>{intros.servicesHeading}</SectionTitle>
      <div class="border-t border-rule">
        {
          services.map(({ data, Content }) => (
            <Row>
              <code slot="aside" class="font-mono text-[15px] text-muted md:pt-1.5">
                {data.flag}
              </code>
              <h3 class="text-[22px] font-bold tracking-[-0.01em]">{data.title}</h3>
              <Prose class="mt-1.5 max-w-2xl">
                <Content />
              </Prose>
            </Row>
          ))
        }
      </div>
    </Container>
  </section>

  <section>
    <Container class="pt-22">
      <SectionTitle>{intros.workHeading}</SectionTitle>
      <div class="border-t border-rule">
        {
          featured.map(({ data }) => (
            <Row>
              <Fragment slot="aside">
                <h3 class="text-[26px] leading-[1.1] font-bold tracking-[-0.015em]">{data.name}</h3>
                {data.url && (
                  <a
                    class="mt-1.5 inline-block font-mono text-sm underline underline-offset-4 hover:decoration-2"
                    href={data.url}
                  >
                    {new URL(data.url).hostname.replace(/^www\./, '')}
                  </a>
                )}
              </Fragment>
              <p class="max-w-2xl">{data.role}</p>
              <p class="mt-2 text-base text-muted">{data.technologies.join(', ')}</p>
            </Row>
          ))
        }
      </div>
      <a
        class="mt-7 inline-block font-bold underline decoration-1 underline-offset-4 hover:decoration-2"
        href={localePath(locale, '/work')}
      >
        {t('work.all')}
      </a>
    </Container>
  </section>
  <Contact locale={locale} />
</BaseLayout>
