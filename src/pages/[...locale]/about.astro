---
import type { GetStaticPaths } from 'astro';

import Container from '../../components/Container.astro';
import PageHeader from '../../components/PageHeader.astro';
import Prose from '../../components/Prose.astro';
import Row from '../../components/Row.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { getLocalizedRendered, getSection } from '../../i18n/content';
import { localeRoutes } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);

const [bio, interests, skills, experience, education, theses] = await Promise.all([
  getSection('about-bio', locale),
  getSection('about-interests', locale),
  getSection('about-skills', locale),
  getLocalizedRendered('experience', locale),
  getLocalizedRendered('education', locale),
  getLocalizedRendered('publications', locale),
]);

const linkText = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<BaseLayout
  locale={locale}
  path="/about"
  title={bio.seoTitle ?? t('title.about')}
  description={t('meta.about')}
  schema="profile"
>
  <PageHeader heading={bio.heading ?? ''} />

  <Container class="pt-14">
    <div class="grid gap-10 md:grid-cols-[1fr_18rem] md:gap-16">
      <div>
        <Prose class="max-w-2xl text-xl"><bio.Content /></Prose>
        {
          bio.links && (
            <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[15px]">
              {bio.links.map((link) => (
                <li>
                  <a
                    class="underline underline-offset-4 hover:decoration-2"
                    href={link.url}
                    rel="me"
                  >
                    {linkText(link.url)}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        bio.photo && (
          <img
            class="aspect-square w-full max-w-72 object-cover max-md:-order-1"
            src={bio.photo}
            alt={bio.photoAlt ?? ''}
            width="600"
            height="600"
          />
        )
      }
    </div>

    <section class="pt-20">
      <SectionTitle>{interests.heading}</SectionTitle>
      <Prose class="max-w-2xl"><interests.Content /></Prose>
    </section>

    <section class="pt-20">
      <SectionTitle>{skills.heading}</SectionTitle>
      <Prose class="mb-8 max-w-2xl"><skills.Content /></Prose>
      <div class="border-t border-rule">
        {
          (skills.groups ?? []).map((group) => (
            <Row>
              <span slot="aside" class="font-mono text-[15px] text-muted md:pt-0.5">
                {group.level}
              </span>
              <p>{group.items.join(', ')}</p>
            </Row>
          ))
        }
      </div>
    </section>

    <section class="pt-20">
      <SectionTitle>{t('about.experience')}</SectionTitle>
      <div class="border-t border-rule">
        {
          experience.map(({ data, Content }) => (
            <Row>
              <span slot="aside" class="font-mono text-sm text-muted md:pt-1">
                {data.duration.start}
                <br class="max-md:hidden" />
                <span class="md:hidden"> – </span>
                {data.duration.end}
              </span>
              <h3 class="text-[22px] leading-snug font-bold tracking-[-0.01em]">
                {data.position}{' '}
                <span class="font-normal text-muted">
                  @
                  {data.company.url ? (
                    <a
                      class="underline underline-offset-4 hover:decoration-2"
                      href={data.company.url}
                    >
                      {data.company.name}
                    </a>
                  ) : (
                    data.company.name
                  )}
                </span>
              </h3>
              <Prose class="mt-2 max-w-2xl">
                <Content />
              </Prose>
              <p class="mt-3 text-base text-muted">{data.main_technologies.join(', ')}</p>
            </Row>
          ))
        }
      </div>
    </section>

    <section class="pt-20">
      <SectionTitle>{t('about.education')}</SectionTitle>
      <div class="border-t border-rule">
        {
          education.map(({ data, Content }) => (
            <Row>
              <span slot="aside" class="font-mono text-sm text-muted md:pt-1">
                {data.duration.start}–{data.duration.end}
              </span>
              <h3 class="text-[22px] leading-snug font-bold tracking-[-0.01em]">
                <a class="hover:underline hover:underline-offset-4" href={data.place.url}>
                  {data.place.name}
                </a>
              </h3>
              <p class="mt-1 text-muted">{data.details.join(', ')}</p>
              <Prose class="mt-2 max-w-2xl">
                <Content />
              </Prose>
            </Row>
          ))
        }
      </div>

      <h3 class="mt-14 mb-4 text-[22px] font-bold tracking-[-0.01em]" id="theses">
        {t('about.theses')}
      </h3>
      <div class="border-t border-rule">
        {
          theses.map(({ data, Content }) => (
            <details class="group border-b border-rule">
              <summary class="grid cursor-pointer list-none gap-1 py-5 md:grid-cols-[11rem_1fr] md:gap-7 [&::-webkit-details-marker]:hidden">
                <span class="font-mono text-sm text-muted md:pt-1">{data.year}</span>
                <span>
                  <span class="block font-bold">{data.title}</span>
                  <span class="block text-base text-muted">
                    <span class="font-mono group-open:hidden" aria-hidden="true">
                      +{' '}
                    </span>
                    <span class="hidden font-mono group-open:inline" aria-hidden="true">
                      −{' '}
                    </span>
                    {data.subtitle}, {data.tags.join(', ')}
                  </span>
                </span>
              </summary>
              <Prose class="max-w-2xl pb-6 text-base md:ml-[calc(11rem+1.75rem)]">
                <Content />
              </Prose>
            </details>
          ))
        }
      </div>
    </section>
  </Container>
</BaseLayout>
