---
import type { GetStaticPaths } from 'astro';

import BulletList from '../../components/BulletList.astro';
import Icon from '../../components/Icon.astro';
import Rule from '../../components/Rule.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { getLocalizedRendered, getSection } from '../../i18n/content';
import { localeRoutes } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);

const [bio, interests, skills, experience, education] = await Promise.all([
  getSection('about-bio', locale),
  getSection('about-interests', locale),
  getSection('about-skills', locale),
  getLocalizedRendered('experience', locale),
  getLocalizedRendered('education', locale),
]);
---

<BaseLayout locale={locale} path="/about" title={t('title.about')}>
  <section class="bg-surface px-6 py-12">
    <SectionHeading title={bio.sectionHeading ?? ''} />

    <div class="grid gap-6 md:grid-cols-3">
      <div>
        {
          bio.photo && (
            <img
              class="mx-auto size-[300px] max-w-full rounded-full object-cover"
              src={bio.photo}
              alt={bio.photoAlt ?? ''}
              width="300"
              height="300"
            />
          )
        }
      </div>

      <div>
        <h3 class="mb-4 text-xl">{bio.heading}</h3>
        <div class="prose-content"><bio.Content /></div>
        {bio.links && <SocialLinks locale={locale} links={bio.links} />}
      </div>

      <div>
        <h3 class="mb-4 text-xl">{interests.heading}</h3>
        <div class="prose-content"><interests.Content /></div>
      </div>
    </div>
  </section>

  <section class="px-6 py-12 text-center">
    <SectionHeading title={skills.heading ?? ''} />
    <div class="prose-content mx-auto text-xl text-ink-muted"><skills.Content /></div>

    {
      (skills.groups ?? []).map((group) => (
        <Fragment>
          <h3 class="mt-6 text-xl">{group.level}</h3>
          <Rule variant="sub" />
          <BulletList items={group.items} class="justify-center pb-2" />
        </Fragment>
      ))
    }
  </section>

  <section class="bg-surface px-6 py-12">
    <SectionHeading title={t('about.experience')} />

    {
      experience.map(({ data, Content }) => (
        <article class="mb-6 text-center">
          <div class="flex flex-wrap items-center justify-center gap-x-2">
            <h3 class="text-xl font-bold">{data.position}</h3>
            {data.company.url ? (
              <a class="link" href={data.company.url}>
                @{data.company.name}
              </a>
            ) : (
              <span>@{data.company.name}</span>
            )}
          </div>
          <div>
            <span>{data.duration.start}</span> - <span>{data.duration.end}</span>
          </div>
          <Rule variant="sub" />
          <BulletList items={data.main_technologies} class="justify-center pb-2" />
          <div class="prose-content">
            <Content />
          </div>
        </article>
      ))
    }
  </section>

  <section class="px-6 py-12">
    <SectionHeading title={t('about.education')} />

    {
      education.map(({ data, Content }) => (
        <article class="mb-6 text-center">
          <div class="flex flex-wrap items-center justify-center gap-x-2">
            <h3 class="text-xl font-bold">{data.place.name}</h3>
            <a class="text-ink transition-colors hover:text-accent" href={data.place.url}>
              <Icon name="link" size={16} title={t('link.website')} />
            </a>
          </div>
          <BulletList items={data.details} class="justify-center" />
          <div>
            <span>{data.duration.start}</span>-<span>{data.duration.end}</span>
          </div>
          <Rule variant="sub" />
          <div class="prose-content">
            <Content />
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>
