---
import type { GetStaticPaths } from 'astro';

import BulletList from '../../components/BulletList.astro';
import Rule from '../../components/Rule.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getLocalizedRendered, getSection } from '../../i18n/content';
import { localeRoutes } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);

const [page, intros, services, references] = await Promise.all([
  getSection('services', locale),
  getSection('page-intros', locale),
  getLocalizedRendered('services', locale),
  getLocalizedRendered('references', locale),
]);

const featured = references.filter((reference) => reference.data.featured);
const more = references.filter((reference) => !reference.data.featured);
const years = ({ start, end }: { start: string; end: string }) =>
  start === end ? start : `${start}–${end}`;
---

<BaseLayout
  locale={locale}
  path="/services"
  title={intros.servicesSeoTitle ?? intros.servicesHeading ?? ''}
  description={page.subtitle}
  schema="services"
  services={services.map((service) => ({
    name: service.data.title,
    description: service.data.items.join(', '),
  }))}
>
  <section class="bg-surface px-6 py-12">
    <h1 class="text-[2rem] leading-tight font-semibold">{page.heading}</h1>
    {page.subtitle && <h2 class="mt-1 text-xl text-ink-muted">{page.subtitle}</h2>}
    <div class="prose-content mt-4 max-w-3xl"><page.Content /></div>
  </section>

  <section class="px-6 py-12">
    <div class="mx-auto grid max-w-5xl gap-8 sm:grid-cols-2">
      {
        services.map(({ data, Content }) => (
          <article>
            <h3 class="text-xl font-bold">{data.title}</h3>
            <Rule variant="sub" />
            <div class="prose-content">
              <Content />
            </div>
            <BulletList items={data.items} class="mt-2 justify-start text-ink-muted" />
          </article>
        ))
      }
    </div>
  </section>

  {
    page.partnerName && (
      <section class="bg-surface px-6 py-12 text-center">
        <SectionHeading title={page.partnerHeading ?? ''} />
        <p class="mx-auto max-w-2xl">{page.partnerText}</p>
        {page.partnerUrl && (
          <p class="mt-4">
            <a class="link" href={page.partnerUrl}>
              {page.partnerName}
            </a>
          </p>
        )}
      </section>
    )
  }

  <section class="px-6 py-12">
    <SectionHeading title={page.referencesHeading ?? ''} />
    {
      page.referencesSubtitle && (
        <p class="mb-8 text-center text-ink-muted">{page.referencesSubtitle}</p>
      )
    }

    {
      featured.map(({ data, Content }) => (
        <article class="mb-8 text-center">
          <div class="flex flex-wrap items-center justify-center gap-x-2">
            <h3 class="text-xl font-bold">
              {data.url ? (
                <a class="link" href={data.url}>
                  {data.name}
                </a>
              ) : (
                data.name
              )}
            </h3>
          </div>
          <p class="text-ink-muted">{data.role}</p>
          <div>
            <span>{data.duration.start}</span>-<span>{data.duration.end}</span>
          </div>
          <Rule variant="sub" />
          <BulletList items={data.technologies} class="justify-center pb-2" />
          <div class="prose-content mx-auto max-w-3xl">
            <Content />
          </div>
        </article>
      ))
    }

    {
      more.length > 0 && (
        <div class="mx-auto mt-16 max-w-4xl">
          <h3 class="mb-4 text-xl font-bold">{t('services.moreProjects')}</h3>
          <ul class="border-t border-rule">
            {more.map(({ data }) => (
              <li class="grid gap-1 border-b border-rule py-3 sm:grid-cols-[13rem_1fr_6rem] sm:gap-6">
                <span class="font-bold text-ink">
                  {data.url ? (
                    <a class="link" href={data.url}>
                      {data.name}
                    </a>
                  ) : (
                    data.name
                  )}
                </span>
                <span>
                  {data.role}
                  {data.technologies.length > 0 && (
                    <span class="block text-sm text-ink-faint">{data.technologies.join(', ')}</span>
                  )}
                </span>
                <span class="text-sm text-ink-faint sm:text-right">{years(data.duration)}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>
</BaseLayout>
