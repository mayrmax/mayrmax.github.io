---
import type { GetStaticPaths } from 'astro';

import Contact from '../../components/Contact.astro';
import Container from '../../components/Container.astro';
import PageHeader from '../../components/PageHeader.astro';
import Prose from '../../components/Prose.astro';
import Row from '../../components/Row.astro';
import { getLocalizedRendered, getSection } from '../../i18n/content';
import { localeRoutes } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

const { locale } = Astro.props;

const [page, intros, services] = await Promise.all([
  getSection('services', locale),
  getSection('page-intros', locale),
  getLocalizedRendered('services', locale),
]);
---

<BaseLayout
  locale={locale}
  path="/services"
  title={intros.servicesSeoTitle ?? intros.servicesHeading ?? ''}
  description={page.subtitle}
  schema="services"
  services={services.map((service) => ({
    name: service.data.title,
    description: service.data.items.join(', '),
  }))}
>
  <PageHeader heading={page.heading ?? ''} subtitle={page.subtitle}>
    <Prose class="mt-6 max-w-2xl"><page.Content /></Prose>
  </PageHeader>

  <Container class="pt-16">
    <div class="border-t border-rule">
      {
        services.map(({ data, Content }) => (
          <Row>
            <code slot="aside" class="font-mono text-[15px] text-muted md:pt-1.5">
              {data.flag}
            </code>
            <h2 class="text-[22px] font-bold tracking-[-0.01em]">{data.title}</h2>
            <Prose class="mt-1.5 max-w-2xl">
              <Content />
            </Prose>
            <p class="mt-2 text-base text-muted">{data.items.join(', ')}</p>
          </Row>
        ))
      }
    </div>

    {
      page.partnerName && (
        <aside class="mt-16 max-w-2xl border-l-2 border-ink pl-6">
          <h2 class="text-[22px] font-bold tracking-[-0.01em]">{page.partnerHeading}</h2>
          <p class="mt-1.5">{page.partnerText}</p>
          {page.partnerUrl && (
            <a
              class="mt-3 inline-block font-mono text-sm underline underline-offset-4 hover:decoration-2"
              href={page.partnerUrl}
            >
              {new URL(page.partnerUrl).hostname.replace(/^www\./, '')}
            </a>
          )}
        </aside>
      )
    }
  </Container>
  <Contact locale={locale} />
</BaseLayout>
