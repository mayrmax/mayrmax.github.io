---
import type { GetStaticPaths } from 'astro';

import Container from '../../components/Container.astro';
import PageHeader from '../../components/PageHeader.astro';
import Prose from '../../components/Prose.astro';
import { getShared } from '../../i18n/content';
import { localeRoutes } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const doc = await getShared('datenschutz');
---

<BaseLayout
  locale={locale}
  path="/datenschutz"
  title={t('title.datenschutz')}
  description={t('meta.datenschutz')}
>
  <PageHeader heading={doc.heading} />
  <Container class="pt-12">
    <Prose class="max-w-prose"><doc.Content /></Prose>
  </Container>
</BaseLayout>
