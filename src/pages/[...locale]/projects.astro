---
import type { GetStaticPaths } from 'astro';

import BulletList from '../../components/BulletList.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import Rule from '../../components/Rule.astro';
import { getLocalizedRendered, getSection } from '../../i18n/content';
import { localeRoutes } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const intros = await getSection('page-intros', locale);
const projects = await getLocalizedRendered('projects', locale);
---

<BaseLayout
  locale={locale}
  path="/projects"
  title={intros.projectsSeoTitle ?? intros.projectsHeading ?? ''}
  description={intros.projectsSubtitle}
>
  <PageHero heading={intros.projectsHeading ?? ''} subtitle={intros.projectsSubtitle} />

  {
    projects.map(({ data, Content }) => (
      <section id={data.anchor} class="px-6 pt-12 text-center">
        <article>
          <div class="flex flex-wrap items-center justify-center gap-x-2">
            <h2 class="text-[2rem] leading-tight font-bold">{data.name}</h2>
            {data.github && (
              <a class="text-ink transition-colors hover:text-accent" href={data.github}>
                <Icon name="github" size={20} title={t('link.github')} />
              </a>
            )}
            {data.youtube && (
              <a class="text-ink transition-colors hover:text-accent" href={data.youtube}>
                <Icon name="youtube" size={20} title={t('link.youtube')} />
              </a>
            )}
          </div>
          <BulletList items={data.technologies} class="justify-center text-xl text-ink-muted" />
          <div>
            <span>{data.duration.start}</span>-<span>{data.duration.end}</span>
          </div>
          <Rule variant="sub" />
          <div class="prose-content">
            <Content />
          </div>
        </article>
      </section>
    ))
  }
</BaseLayout>
