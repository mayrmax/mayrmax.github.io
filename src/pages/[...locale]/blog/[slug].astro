---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';

import Container from '../../../components/Container.astro';
import Prose from '../../../components/Prose.astro';
import { isLocale, localeParam, localePath } from '../../../i18n/config';
import { entrySlug } from '../../../i18n/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDate, toISODate } from '../../../utils/date';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const locale = post.id.slice(0, post.id.indexOf('/'));
    if (!isLocale(locale)) throw new Error(`Blog entry outside a locale directory: ${post.id}`);
    return {
      params: { locale: localeParam(locale), slug: entrySlug(post.id) },
      props: { post, locale },
    };
  });
}) satisfies GetStaticPaths;

const { post, locale } = Astro.props;
const { Content } = await render(post);
const slug = entrySlug(post.id);
---

<BaseLayout
  locale={locale}
  path={`/blog/${slug}`}
  title={post.data.title}
  description={post.data.subtitle}
  schema="article"
  article={{
    headline: post.data.title,
    description: post.data.subtitle,
    datePublished: post.data.date.toISOString(),
    url: new URL(localePath(locale, `/blog/${slug}`), Astro.site).href,
  }}
>
  <article>
    <header class="border-b border-rule">
      <Container class="pt-14 pb-12 sm:pt-20 sm:pb-16">
        <p class="font-mono text-sm text-muted">
          <time datetime={toISODate(post.data.date)}>{formatDate(post.data.date, locale)}</time>
        </p>
        <h1
          class="hyphens-auto mt-4 max-w-[20ch] text-[clamp(36px,5.4vw,64px)] leading-[1.04] font-bold tracking-[-0.025em]"
        >
          {post.data.title}
        </h1>
        {post.data.subtitle && <p class="mt-4 text-xl text-muted">{post.data.subtitle}</p>}
      </Container>
    </header>

    <Container class="pt-12">
      <Prose class="max-w-prose"><Content /></Prose>
    </Container>
  </article>
</BaseLayout>
