---
import type { GetStaticPaths } from 'astro';

import Container from '../../../components/Container.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Row from '../../../components/Row.astro';
import { localePath } from '../../../i18n/config';
import { entrySlug, getLocalized, getSection } from '../../../i18n/content';
import { localeRoutes } from '../../../i18n/routes';
import { useTranslations } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDate, toISODate } from '../../../utils/date';
import { readingMinutes } from '../../../utils/reading-time';
import { hashtag } from '../../../utils/tags';

export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const intros = await getSection('page-intros', locale);
const posts = (await getLocalized('blog', locale)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  locale={locale}
  path="/blog"
  title={intros.blogSeoTitle ?? intros.blogHeading ?? ''}
  description={intros.blogSubtitle}
>
  <PageHeader heading={intros.blogHeading ?? ''} subtitle={intros.blogSubtitle} />

  <Container class="pt-16">
    <div class="border-t border-rule">
      {
        posts.map((post) => (
          <Row>
            <time
              slot="aside"
              class="font-mono text-sm text-muted md:pt-1.5"
              datetime={toISODate(post.data.date)}
            >
              {formatDate(post.data.date, locale)}
            </time>
            <h2 class="text-[22px] font-bold tracking-[-0.01em]">
              <a
                class="hover:underline hover:decoration-2 hover:underline-offset-4"
                href={localePath(locale, `/blog/${entrySlug(post.id)}`)}
              >
                {post.data.title}
              </a>
            </h2>
            {post.data.description && <p class="mt-1.5 max-w-2xl">{post.data.description}</p>}
            <p class="mt-2 font-mono text-sm text-muted">
              {readingMinutes(post.body)} {t('blog.minutes')}
              {post.data.tags.length > 0 && ` · ${post.data.tags.map(hashtag).join(' ')}`}
            </p>
          </Row>
        ))
      }
    </div>
  </Container>
</BaseLayout>
