---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

import Container from '../../../../components/Container.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import Prose from '../../../../components/Prose.astro';
import { isLocale, localeParam, type Locale } from '../../../../i18n/config';
import { entrySlug } from '../../../../i18n/content';
import { appPrivacyPath } from '../../../../i18n/routes';
import { useTranslations } from '../../../../i18n/ui';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const localeOf = (entry: CollectionEntry<'privacy'>): Locale => {
    const locale = entry.id.slice(0, entry.id.indexOf('/'));
    if (!isLocale(locale)) throw new Error(`Privacy entry outside a locale directory: ${entry.id}`);
    return locale;
  };
  const policies = await getCollection('privacy');
  return policies.map((policy) => {
    const locale = localeOf(policy);
    const app = entrySlug(policy.id);
    const alternates = Object.fromEntries(
      policies
        .filter((candidate) => entrySlug(candidate.id) === app)
        .map((candidate) => [localeOf(candidate), appPrivacyPath(localeOf(candidate), app)]),
    );
    const path = appPrivacyPath(locale, app);
    return {
      params: { locale: localeParam(locale), app, page: path.split('/').pop() },
      props: { policy, locale, path, alternates },
    };
  });
}) satisfies GetStaticPaths;

const { policy, locale, path, alternates } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(policy);
const { app, listed } = policy.data;
---

<BaseLayout
  locale={locale}
  path={path}
  alternates={alternates}
  title={`${app} – ${t('title.appPrivacy')}`}
  description={t('meta.appPrivacy')}
  noindex={!listed}
>
  <PageHeader heading={app} subtitle={t('title.appPrivacy')} />
  <Container class="pt-12">
    <Prose class="max-w-prose"><Content /></Prose>
  </Container>
</BaseLayout>
