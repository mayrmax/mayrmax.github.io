---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

import Container from '../../../../components/Container.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import Prose from '../../../../components/Prose.astro';
import { isLocale, localeParam, type Locale } from '../../../../i18n/config';
import { entrySlug } from '../../../../i18n/content';
import { appPrivacyPath, appSupportPath } from '../../../../i18n/routes';
import { useTranslations } from '../../../../i18n/ui';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

/** Per-app pages: the privacy policy and the support page, one entry per language each. */
export const getStaticPaths = (async () => {
  type Entry = CollectionEntry<'privacy'> | CollectionEntry<'support'>;
  const localeOf = (entry: Entry): Locale => {
    const locale = entry.id.slice(0, entry.id.indexOf('/'));
    if (!isLocale(locale)) throw new Error(`App page outside a locale directory: ${entry.id}`);
    return locale;
  };
  const kinds = [
    { kind: 'privacy' as const, entries: await getCollection('privacy'), pathOf: appPrivacyPath },
    { kind: 'support' as const, entries: await getCollection('support'), pathOf: appSupportPath },
  ];
  return kinds.flatMap(({ kind, entries, pathOf }) =>
    (entries as Entry[]).map((entry) => {
      const locale = localeOf(entry);
      const app = entrySlug(entry.id);
      const alternates = Object.fromEntries(
        (entries as Entry[])
          .filter((candidate) => entrySlug(candidate.id) === app)
          .map((candidate) => [localeOf(candidate), pathOf(localeOf(candidate), app)]),
      );
      const path = pathOf(locale, app);
      return {
        params: { locale: localeParam(locale), app, page: path.split('/').pop() },
        props: { entry, kind, locale, path, alternates },
      };
    }),
  );
}) satisfies GetStaticPaths;

const { entry, kind, locale, path, alternates } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(entry);
const { app, listed } = entry.data;
const subtitle = kind === 'support' ? t('title.appSupport') : t('title.appPrivacy');
const description = kind === 'support' ? t('meta.appSupport') : t('meta.appPrivacy');
---

<BaseLayout
  locale={locale}
  path={path}
  alternates={alternates}
  title={`${app} – ${subtitle}`}
  description={description}
  noindex={!listed}
>
  <PageHeader heading={app} subtitle={subtitle} />
  <Container class="pt-12">
    <Prose class="max-w-prose"><Content /></Prose>
  </Container>
</BaseLayout>
