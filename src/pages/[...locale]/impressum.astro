---
import type { GetStaticPaths } from 'astro';

import { localePath } from '../../i18n/config';
import { getShared } from '../../i18n/content';
import { localeRoutes } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const impressum = await getShared('impressum');
---

<BaseLayout
  locale={locale}
  path="/impressum"
  title={t('title.impressum')}
  description={t('meta.impressum')}
>
  <div class="px-6 py-12">
    <h1 class="text-[2rem] leading-tight font-semibold">{impressum.heading}</h1>
    <div class="prose-content mt-4 max-w-4xl"><impressum.Content /></div>
    <p class="mt-8">
      Informationen zur Verarbeitung personenbezogener Daten finden Sie in der <a
        class="link"
        href={localePath(locale, '/datenschutz')}>Datenschutzerklärung</a
      >.
    </p>
  </div>
</BaseLayout>
