---
import type { GetStaticPaths } from 'astro';

import Container from '../../components/Container.astro';
import PageHeader from '../../components/PageHeader.astro';
import Prose from '../../components/Prose.astro';
import { localePath } from '../../i18n/config';
import { getShared } from '../../i18n/content';
import { localeRoutes } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const doc = await getShared('impressum');
---

<BaseLayout
  locale={locale}
  path="/impressum"
  title={t('title.impressum')}
  description={t('meta.impressum')}
>
  <PageHeader heading={doc.heading} />
  <Container class="pt-12">
    <Prose class="max-w-prose"><doc.Content /></Prose>
    <p class="mt-10 max-w-prose">
      Informationen zur Verarbeitung personenbezogener Daten findest du in der <a
        class="underline underline-offset-4 hover:decoration-2"
        href={localePath(locale, '/datenschutz')}>Datenschutzerklärung</a
      >.
    </p>
  </Container>
</BaseLayout>
